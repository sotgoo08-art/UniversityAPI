const express = require("express");
const { register, login } = require("../controllers/auth-controller");
const { authenticateToken } = require("../middlewares/auth");
const { loadUsers } = require("../data/users");
const { teachers, students, departments } = require("../data/data");

const router = express.Router();
/**
 * @openapi
 * /auth/register:
 *   post:
 *     summary: Auth  /auth/register
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *     responses:
 *       200:
 *         description: OK
 */
router.post("/register", register);
/**
 * @openapi
 * /auth/login:
 *   post:
 *     summary: Auth  /auth/login
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *     responses:
 *       200:
 *         description: OK
 */
router.post("/login", login);

// Нэвтэрсэн хэрэглэгчийн мэдээлэл + өөрийн профайл (багш/оюутан)
/**
 * @openapi
 * /auth/me:
 *   get:
 *     summary: Auth  /auth/me
 *     tags: [Auth]
 *     responses:
 *       200:
 *         description: OK
 */
router.get("/me", authenticateToken, (req, res) => {
  const user = loadUsers().find(u => u.id === Number(req.user.id));
  if (!user) return res.status(404).json({ message: "User not found" });

  let profile = null;
  if (user.role === "teacher") {
    const t = teachers.find(x => x.id === user.teacherId);
    if (t) {
      const d = departments.find(x => x.id === t.departmentId);
      profile = { ...t, departmentName: d ? d.name : null };
    }
  } else if (user.role === "student") {
    profile = students.find(x => x.id === user.studentId) || null;
  }

  res.json({ id: user.id, username: user.username, role: user.role, profile });
});

module.exports = router;